{
  "name": "bacuri.vms.web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "check": "tsc --noEmit && eslint src stories --max-warnings 0 && prettier --check src stories tests .storybook *.mjs *.json",
    "build": "vite build --configLoader native",
    "catalog": "storybook build --disable-telemetry --output-dir /results/storybook",
    "test": "playwright test",
    "app": "vite build --configLoader native --config app.vite.config.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "7.18.6"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.11.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "monocart-coverage-reports": "^2",
    "playwright": "1.64.0",
    "prettier": "^3",
    "storybook": "10.6.8",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
