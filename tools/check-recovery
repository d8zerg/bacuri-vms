#!/usr/bin/env python3
"""Control faults only within a disposable Compose project."""
import os
from pathlib import Path
import subprocess
import sys
import uuid


def main():
    preset = sys.argv[1]
    token = uuid.uuid4().hex
    report = Path(subprocess.check_output(["sh", "tools/quality-report-dir", "recovery"], text=True).strip())
    print(f"Recovery report: {report}", flush=True)
    project = ["docker", "compose", "-p", "bacuri-recovery-" + token,
               "-f", "compose.yaml", "-f", "tests/recovery/compose.yaml"]
    env = dict(os.environ)
    env["BACURI_RECOVERY_PRESET"] = preset
    for service, key in [("dev", "BACURI_DEV_IMAGE"), ("rtsp-camera", "BACURI_RECOVERY_CAMERA_IMAGE")]:
        env[key] = subprocess.check_output(["docker", "compose", "config", "--images", service], text=True).strip()

    def compose(*args, **kwargs):
        return subprocess.run([*project, *args], env=env, check=True, **kwargs)

    try:
        compose("up", "-d", "--no-build", "--wait", "--wait-timeout", "60", "postgres", "rtsp-camera")
        run = ["run", "--rm", "--no-deps", "-T", "--user", f"{os.getuid()}:{os.getgid()}"]
        with subprocess.Popen([*project, *run, "-e", f"BACURI_RECOVERY_REPORT=/workspace/{report}/{preset}.json",
                               "dev", "sh", "tests/check-control.sh", preset, "recovery"],
                              env=env, text=True, stdin=subprocess.PIPE, stdout=subprocess.PIPE) as test:
            for line in test.stdout:
                fields = line.strip().split()
                if fields[:1] != ["FAULT"]:
                    print(line, end="", flush=True)
                    continue
                if fields[1:] in (["stop", "postgres"], ["stop", "rtsp-camera"]):
                    compose(*fields[1:], stdout=sys.stderr)
                elif fields[1:] in (["start", "postgres"], ["start", "rtsp-camera"]):
                    compose("up", "-d", "--no-build", "--wait", fields[2], stdout=sys.stderr)
                elif len(fields) == 3 and fields[1] == "detached" and fields[2].startswith("bacuri_control_"):
                    # A separate container opens the same database with no archive volume attached.
                    outcome = subprocess.run([*project, "run", "--rm", "--no-deps", "-T",
                        "-e", "PGDATABASE=" + fields[2], "-e", "BACURI_ARCHIVE_DIR=/archive/recorder",
                        "-e", "BACURI_SITE_ID=10000000-0000-4000-8000-000000000001",
                        "-e", "BACURI_NODE_ID=70000000-0000-4000-8000-000000000001",
                        "core", "/opt/bacuri/bacuri-vms-core", "rebuild-archive"], env=env, capture_output=True)
                    if outcome.returncode != 1 or b"volume unavailable" not in outcome.stderr:
                        raise RuntimeError(outcome.stderr.decode())
                else:
                    raise ValueError(f"Unexpected fault request {fields}")
                test.stdin.write("ok\n")
                test.stdin.flush()
            if test.wait():
                raise RuntimeError("Recovery gate failed")
    finally:
        compose("down", "--volumes", "--timeout", "3")


if __name__ == "__main__":
    main()
