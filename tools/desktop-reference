#!/bin/sh
# Write the reference recordings of the desktop workstation: H.264 High and H.265 Main 8-bit,
# 1920x1080 at 25 fps, 60 s, fragmented MP4 with 2 s keyframe intervals. Each frame shows its
# number from zero and its buffer time, so a displayed frame can be compared with the source.
set -eu

out=${1:-build/desktop/reference}
frames=1500
mkdir -p "$out"

source="videotestsrc num-buffers=$frames pattern=smpte is-live=false \
  ! video/x-raw,format=I420,width=1920,height=1080,framerate=25/1 \
  ! timeoverlay time-mode=buffer-count halignment=left valignment=top font-desc=\"Sans 64\" text=frame \
  ! timeoverlay time-mode=buffer-time halignment=right valignment=bottom font-desc=\"Monospace 48\""

# shellcheck disable=SC2086
eval gst-launch-1.0 -q -e $source \
  ! x264enc key-int-max=50 bitrate=6000 speed-preset=medium \
  ! video/x-h264,profile=high ! h264parse ! mp4mux fragment-duration=2000 \
  ! filesink location="$out/h264-1080p25.mp4"

# shellcheck disable=SC2086
eval gst-launch-1.0 -q -e $source \
  ! x265enc key-int-max=50 bitrate=6000 speed-preset=fast \
  ! video/x-h265,profile=main ! h265parse ! mp4mux fragment-duration=2000 \
  ! filesink location="$out/h265-1080p25.mp4"

cd "$out"
sha256sum h264-1080p25.mp4 h265-1080p25.mp4 > SHA256SUMS
# Check each file: the codec profile, the size, the frame rate, the number of frames and the
# keyframe interval from the MP4 boxes, then a complete software decode.
tools=$(cd "$OLDPWD" && pwd)/tools
for entry in h264:high h265:main; do
  codec=${entry%%:*}
  file=$codec-1080p25.mp4
  python3 "$tools/desktop_reference_check.py" "$file" --codec "$codec" --profile "${entry##*:}" \
    --size 1920x1080 --fps 25 --frames "$frames" --keyframe-interval 50
  gst-launch-1.0 -q filesrc location="$file" ! qtdemux ! "${codec}parse" ! "avdec_$codec" ! fakesink
done
