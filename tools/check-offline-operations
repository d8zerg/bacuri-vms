#!/usr/bin/env bash
set -euo pipefail
report=$(realpath "$1")
previous=$(realpath "$2")
export BACURI_INSTALL_REPORT="$report"
export BACURI_INSTALL_VM_IMAGE=$(docker compose config --images install-vm)
test -f "$previous/bundle/SHA256SUMS.sig"
docker compose run --rm --no-deps -T --entrypoint cat rtsp-camera /usr/local/bin/bacuri-vms-test-rtsp-camera >"$report/test-camera"
docker compose run --rm --no-deps -T builder cat /usr/lib/x86_64-linux-gnu/gstreamer-1.0/libgstpango.so >"$report/test-overlay.so"
project=(docker compose -p "bacuri-operations-$(cat /proc/sys/kernel/random/uuid)" -f compose.yaml -f tests/offline/compose.yaml)
trap '"${project[@]}" --profile tools --profile playback-test down --volumes' EXIT
"${project[@]}" up -d --no-build --wait playback-chrome
"${project[@]}" run --rm --no-deps --use-aliases -v "$previous:/previous:ro" -T install-vm python3 -B tests/offline/operations.py
