#!/usr/bin/env bash
set -euo pipefail
report=$1
export BACURI_BASIC_REPORT=$(realpath "$report")
export BACURI_BASIC_VM_IMAGE=$(docker compose config --images basic-vm)
project=(docker compose -p "bacuri-install-$(cat /proc/sys/kernel/random/uuid)" -f compose.yaml -f tests/basic/compose.yaml)
trap '"${project[@]}" --profile tools --profile playback-test down --volumes' EXIT
"${project[@]}" up -d --no-build --wait playback-chrome
"${project[@]}" run --rm --no-deps --use-aliases -T \
    -e "BACURI_TEST_ENGINE=$(docker version --format '{{.Server.Version}}')" \
    -e "BACURI_TEST_COMPOSE=$(docker compose version --short)" basic-vm
