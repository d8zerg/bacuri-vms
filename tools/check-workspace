#!/usr/bin/env bash
set -euo pipefail
mode=${2:-full}
case "$mode" in full|coverage) ;; *) echo "Unknown workspace check: $mode" >&2; exit 2 ;; esac
report=$(sh tools/quality-report-dir workspace)
# Create the nested mount point as the build user before Docker mounts the web client over it.
mkdir -p "$report/client"
export BACURI_UI_RESULTS="$PWD/$report"
echo "Workspace evidence: $report"
run=(docker compose run --rm --no-deps -T --user "$(id -u):$(id -g)")
"${run[@]}" -v "$PWD/build/web-client:/results/client:ro" ui-kit-check node tests/first-paint.mjs
"${run[@]}" ui-kit-check
bash tests/workspace/isolated.sh "$1" "$report"
docker compose up -d --wait playback-chrome playback-firefox
trap 'docker compose stop playback-chrome playback-firefox' EXIT
"${run[@]}" -e "BACURI_WORKSPACE_RESULTS=/workspace/$report" dev sh tests/check-control.sh "$1" workspace
"${run[@]}" -e "BACURI_WORKSPACE_RESULTS=/workspace/$report" dev sh tests/check-control.sh "$1" monitoring
"${run[@]}" -e "BACURI_WORKSPACE_RESULTS=/workspace/$report" dev sh tests/check-control.sh "$1" policies
"${run[@]}" -e "BACURI_WORKSPACE_RESULTS=/workspace/$report" dev sh tests/check-control.sh "$1" investigations
"${run[@]}" -v "$PWD/build/web-client:/results/client:ro" ui-kit-check node tests/workspace-coverage.mjs
if [[ "$mode" == full ]]; then
    "${run[@]}" builder python3 tests/workspace/performance.py "$report/performance.json"
fi
