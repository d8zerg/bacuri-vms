{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BACURI_VMS_BUILD_RTSP_FIXTURE": true
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "dev-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "dev-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-19"
      }
    },
    {
      "name": "clang-asan-ubsan",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined"
      }
    },
    {
      "name": "clang-tsan",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-asan-ubsan", "configurePreset": "clang-asan-ubsan" },
    { "name": "clang-tsan", "configurePreset": "clang-tsan" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "gcc-debug", "inherits": "test-base", "configurePreset": "gcc-debug" },
    { "name": "clang-debug", "inherits": "test-base", "configurePreset": "clang-debug" },
    { "name": "clang-asan-ubsan", "inherits": "test-base", "configurePreset": "clang-asan-ubsan" },
    { "name": "clang-tsan", "inherits": "test-base", "configurePreset": "clang-tsan" }
  ]
}
