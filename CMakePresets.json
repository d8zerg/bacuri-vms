{
  "version": 6,
  "configurePresets": [
    {
      "name": "build-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{BACURI_CONAN_GENERATORS}/conan_toolchain.cmake",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "Boost_DIR": "$env{BACURI_CONAN_GENERATORS}",
        "nlohmann_json_DIR": "$env{BACURI_CONAN_GENERATORS}",
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "dev-base",
      "hidden": true,
      "inherits": "build-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GTest_DIR": "$env{BACURI_CONAN_GENERATORS}",
        "BUILD_TESTING": true,
        "BACURI_VMS_BUILD_RTSP_FIXTURE": true
      }
    },
    {
      "name": "gcc-release",
      "inherits": "build-base",
      "environment": { "BACURI_CONAN_GENERATORS": "/opt/bacuri/deps/gcc-release" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "BACURI_VMS_BUILD_RTSP_FIXTURE": false
      }
    },
    {
      "name": "bookworm-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/bookworm-release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-12",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "/opt/bacuri/deps/gcc-release",
        "CMAKE_COMPILE_WARNING_AS_ERROR": true,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "gcc-debug",
      "inherits": "dev-base",
      "environment": { "BACURI_CONAN_GENERATORS": "/opt/bacuri/deps/gcc-debug" }
    },
    {
      "name": "gcc-coverage",
      "inherits": "gcc-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-update=atomic"
      }
    },
    { "name": "gcc-unit-coverage", "inherits": "gcc-coverage" },
    {
      "name": "clang-debug",
      "inherits": "dev-base",
      "environment": { "BACURI_CONAN_GENERATORS": "/opt/bacuri/deps/clang-debug" }
    },
    {
      "name": "clang-asan-ubsan",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined"
      }
    },
    {
      "name": "clang-tsan",
      "inherits": "clang-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "bookworm-release", "configurePreset": "bookworm-release" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-coverage", "configurePreset": "gcc-coverage" },
    { "name": "gcc-unit-coverage", "configurePreset": "gcc-unit-coverage" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-asan-ubsan", "configurePreset": "clang-asan-ubsan" },
    { "name": "clang-tsan", "configurePreset": "clang-tsan" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "gcc-debug", "inherits": "test-base", "configurePreset": "gcc-debug" },
    { "name": "gcc-coverage", "inherits": "test-base", "configurePreset": "gcc-coverage" },
    { "name": "gcc-unit-coverage", "inherits": "test-base", "configurePreset": "gcc-unit-coverage" },
    { "name": "clang-debug", "inherits": "test-base", "configurePreset": "clang-debug" },
    { "name": "clang-asan-ubsan", "inherits": "test-base", "configurePreset": "clang-asan-ubsan" },
    { "name": "clang-tsan", "inherits": "test-base", "configurePreset": "clang-tsan" }
  ]
}
