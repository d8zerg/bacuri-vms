{
  "version": 6,
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Desktop client, GCC, optimized with debug information",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/desktop/gcc",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-14",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [{"name": "desktop", "configurePreset": "desktop"}],
  "testPresets": [
    {"name": "desktop", "configurePreset": "desktop", "output": {"outputOnFailure": true}}
  ]
}
