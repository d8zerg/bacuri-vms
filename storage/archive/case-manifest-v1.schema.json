{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bacuri.vms:archive:case-manifest:1",
  "title": "Bacuri VMS signed investigation case manifest v1",
  "description": "manifest.json at the root of a case package. Each part is a directory material-N holding a signed export of one material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "case", "export_id", "site_id", "reason", "mode", "parts"],
  "properties": {
    "format": { "const": "bacuri.vms.case.v1" },
    "case": {
      "description": "The investigation as stored by the site at export time. materials lists the exported points and intervals in the order of the parts.",
      "type": "object",
      "required": ["id", "materials"],
      "properties": {
        "id": { "$ref": "urn:bacuri.vms:archive:block-manifest:1#/$defs/id" },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["point_id"],
            "properties": { "point_id": { "$ref": "urn:bacuri.vms:archive:block-manifest:1#/$defs/id" } }
          }
        }
      }
    },
    "export_id": { "$ref": "urn:bacuri.vms:archive:block-manifest:1#/$defs/id" },
    "site_id": { "$ref": "urn:bacuri.vms:archive:block-manifest:1#/$defs/id" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "mode": { "enum": ["original", "derivative"] },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directory", "manifest_sha256", "point_id", "begin_utc_us", "end_utc_us"],
        "properties": {
          "directory": { "type": "string", "pattern": "^material-[1-9][0-9]*$" },
          "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "point_id": { "$ref": "urn:bacuri.vms:archive:block-manifest:1#/$defs/id" },
          "begin_utc_us": { "$ref": "urn:bacuri.vms:archive:block-manifest:1#/$defs/i64" },
          "end_utc_us": { "$ref": "urn:bacuri.vms:archive:block-manifest:1#/$defs/i64" }
        }
      }
    }
  }
}
